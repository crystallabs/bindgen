module Bindgen
  module Processor
    # Processor for `C++/Qt` specific behaviour.  This includes:
    # * Handle `Q_GADGET` types
    # * Adding signal connection methods, delivering in the main thread
    # * Support for private signals
    # * Remove `Q_OBJECT` internal methods in superclass wrappers
    # * Keep objects given a parent alive, as the parent owns them
    class Qt < Base
      # Type of the result of a Qt-sinal connect call.
      CONNECTION_HANDLE_TYPE = Parser::Type.parse("QMetaObject::Connection")

      # Type of the connection type argument of the connection method.  The
      # enum has to be wrapped, by `enums:` in the configuration.
      CONNECTION_TYPE = Parser::Type.parse("Qt::ConnectionType")

      # Name of the connection type argument, as in `QObject::connect`.
      CONNECTION_TYPE_ARGUMENT = "type"

      # Value of `Qt::AutoConnection`, the default connection type.
      AUTO_CONNECTION = 0_i64

      # We'll remove all member methods of this name.
      QGADGET_CHECKER = "qt_check_for_QGADGET_macro"

      # Defined by `Q_OBJECT`, and thus in every signal-emitting class.
      PRIVATE_SIGNAL = "QPrivateSignal"

      # Internal virtual methods generated by `Q_OBJECT` that will not be copied
      # into superclass wrapper structs.
      Q_OBJECT_IGNORED_METHODS_RX = Regex.union(
        /^metaObject$/, /^qt_metacast$/, /^qt_metacall$/)

      # Classes whose instances belong to their parent, which deletes them.
      PARENT_OWNED_CLASSES = {"QObject", "QGraphicsItem", "QGraphicsLayoutItem"}

      # Methods giving the object a new parent, or none with `nullptr`.
      SET_PARENT_METHODS = {"setParent", "setParentItem", "setParentLayoutItem"}

      # Name of the constructor argument giving the object a parent.
      PARENT_ARGUMENT = "parent"

      def visit_class(klass)
        # The signals still in the graph: Those removed before, like by
        # `ignore_methods` through `Processor::FilterMethods`, get no connection
        # method either.  Private signals are handled below.
        signals = klass.nodes.compact_map do |node|
          node.as?(Graph::Method).try(&.origin).try { |m| m if m.signal? }
        end

        # Filter Qt-specific annoyances out.
        klass.nodes.select! do |node|
          if node.is_a?(Graph::Method)
            if node.origin.member_method? && node.origin.name == QGADGET_CHECKER
              false # Remove qt_check_for_QGADGET_macro
            elsif node.origin.signal? && private_signal_argument(node.origin)
              false # Remove private signal emission method
            else
              true # Keep otherwise
            end
          else
            true # Always keep non-methods
          end
        end

        # Add signals, ignoring default argument values towards the emission
        # method.  Also honour `ignore_methods` in case `filter_methods` runs
        # after this processor.
        ignored = @db[klass.origin.name]?.try(&.ignore_methods)
        signals.each do |method|
          next if ignored.try(&.includes?(method.name))
          handle_signal(klass, method)
        end

        mark_parent_owned(klass) if parent_owned?(klass.origin.name)

        # Remove `Q_OBJECT` internals from the generated superclass wrappers.
        rules = @db.get_or_add(klass.origin.name)
        rules.superclass_ignore_methods += Q_OBJECT_IGNORED_METHODS_RX

        super # Proceed.
      end

      # Is the class *name*, or a base of it, one of `PARENT_OWNED_CLASSES`?
      private def parent_owned?(name : String) : Bool
        seen = Set(String).new
        pending = [name]

        while name = pending.shift?
          next unless seen.add?(name)
          return true if PARENT_OWNED_CLASSES.includes?(name)
          @doc.try(&.classes[name]?).try(&.bases.each { |base| pending << base.name })
        end

        false
      end

      # Tags the methods of *klass* giving the object a parent, so the parent
      # owning the object keeps it alive: `CrystalWrapper` adds the hooks.
      private def mark_parent_owned(klass)
        klass.nodes.each do |node|
          next unless node.is_a?(Graph::Method)
          next if node.tag?(Graph::Method::OWNED_BY_ARGUMENT_TAG)
          next unless index = parent_argument(node.origin)
          node.set_tag(Graph::Method::OWNED_BY_ARGUMENT_TAG, index.to_s)
          make_parent_nilable(node.origin, index) unless node.origin.any_constructor?
        end
      end

      # Lets the parent argument at *index* of the setter *method* be `nil`, as
      # `nullptr` takes the object from its parent.
      private def make_parent_nilable(method : Parser::Method, index : Int32)
        arg = method.arguments[index]
        return if arg.nilable?
        return unless type = arg.make_pointer_nilable

        arguments = method.arguments.dup
        arguments[index] = Parser::Argument.new(arg.name, type, arg.has_default?, arg.value)
        method.arguments = arguments
      end

      # Returns the index of the argument of *method* giving the object a
      # parent, if any: The argument named `parent` of a constructor, or the
      # one object argument of `SET_PARENT_METHODS`, if it's a pointer to a
      # wrapped class.
      private def parent_argument(method : Parser::Method) : Int32?
        if method.any_constructor?
          return if method.copy_constructor?
          index = method.arguments.index(&.name.== PARENT_ARGUMENT)
        elsif SET_PARENT_METHODS.includes?(method.name) && !method.static?
          indices = method.arguments.each_index.select { |i| @db.object_argument?(method.arguments[i]) }.to_a
          index = indices.first if indices.size == 1
        end

        index if index && @db.object_argument?(method.arguments[index])
      end

      # Checks if *signal* is marked private through the private
      # `QPrivateSignal` struct.  We have to handle these differently:
      # 1. The signal emission method must be removed
      # 2. The signal connection method doesn't carry this argument
      private def private_signal_argument(signal : Parser::Method)
        private_struct = "#{signal.class_name}::#{PRIVATE_SIGNAL}"

        signal.arguments.index do |arg|
          arg.base_name == private_struct
        end
      end

      # Adds the `#on_X` connector method of signal *method* into its *parent*.
      private def handle_signal(parent, method : Parser::Method)
        public_signal = unprivate_signal(method)
        connector = add_connect_method(parent, public_signal)
        add_cpp_call(connector, public_signal)
      end

      # Builds a signal *method* without a private signal argument.
      private def unprivate_signal(method : Parser::Method)
        if idx = private_signal_argument(method)
          args = method.arguments.dup # Remove the private argument
          args.delete_at(idx)

          Parser::Method.build(
            name: method.name,
            class_name: method.class_name,
            return_type: method.return_type,
            arguments: args,
          )
        else
          method # Public signal
        end
      end

      private def add_cpp_call(connector, method)
        to_proc = CallBuilder::CppToCrystalProc.new(@db)
        call = CallBuilder::CppQobjectConnect.new(@db)
        wrapper = CallBuilder::CppWrapper.new(@db)

        proc = to_proc.build(method, lambda: true)
        connector.calls[Graph::Platform::Cpp] = wrapper.build(
          method: connector.origin,
          target: call.build(method, proc, connection_type: CONNECTION_TYPE_ARGUMENT),
        )
      end

      # Adds the *signal* connection method to *parent*.
      private def add_connect_method(parent, signal)
        conn_method = signal_connect_binding_method(signal)

        Graph::Method.new(
          origin: conn_method,
          name: conn_method.name,
          parent: parent,
        )
      end

      # Builds the method(s) used to generate the binding to a Qt signals connect
      # method: `on_signal(type : Qt::ConnectionType = AutoConnection, &block)`.
      private def signal_connect_binding_method(signal : Parser::Method)
        proc_type = Parser::Type.proc(Parser::Type::VOID, signal.arguments)
        proc_arg = Parser::Argument.new("_proc_", proc_type)
        type_arg = Parser::Argument.new(
          CONNECTION_TYPE_ARGUMENT, CONNECTION_TYPE,
          has_default: true, value: AUTO_CONNECTION,
        )

        Parser::Method.build(
          name: "CONNECT_#{signal.name}",
          class_name: signal.class_name,
          return_type: CONNECTION_HANDLE_TYPE,
          arguments: [type_arg, proc_arg],
          crystal_name: "on_#{signal.crystal_name}"
        )
      end
    end
  end
end
